{
  "rules": [
    {
      "name": "Do not send  daily menu letters to Directum",
      "enabled": true,
      "when": {
        "sender_email": "KalmykovaRR@taif.ru"
      },
      "actions": [
        {
          "type": "skip_directum",
          "reason": "Письмо от данного отправителя не должно обрабатываться в Directum"
        }
      ]
    },
    {
      "name": "Replace Directum person id 807 with 582",
      "enabled": true,
      "when": {
        "any_id": 807
      },
      "actions": [
        {
          "type": "replace_matched_id",
          "id": 582
        }
      ]
    },
    {
      "name": "Forward recipient 1342 to reception",
      "enabled": true,
      "when": {
        "recipient_id": 1342
      },
      "actions": [
        {
          "type": "forward_email",
          "to": "aksh@taif.ru"
        },
        {
          "type": "skip_directum",
          "reason": "Письмо переслано в приёмную получателя: Шигабутдинов Альберт"
