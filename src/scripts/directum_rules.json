{
  "rules": [
    {
      "name": "Do not send  daily menu letters to Directum",
      "enabled": true,
      "when": {
        "sender_email": "KalmykovaRR@taif.ru"
      },
      "actions": [
        {
          "type": "skip_directum",
          "reason": "Письмо от данного отправителя не должно обрабатываться в Directum"
        }
      ]
    },
    {
      "name": "Replace Directum person id 807 with 582",
      "enabled": true,
      "when": {
        "any_id": 807
      },
      "actions": [
        {
          "type": "replace_matched_id",
          "id": 582
        }
      ]
    }
  ]
}
