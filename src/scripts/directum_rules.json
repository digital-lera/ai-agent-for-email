{
  "rules": [
    {
      "name": "Do not send  daily menu letters to Directum",
      "enabled": true,
      "when": {
        "sender_email": "KalmykovaRR@taif.ru"
      },
      "actions": [
        {
          "type": "skip_directum",
          "reason": "Письмо от данного отправителя не должно обрабатываться в Directum"
        }
      ]
    },
    {
      "name": "Skip mailusers recipient letters",
      "enabled": true,
      "when": {
        "recipient_email": "mailusers@taif.ru"
      },
      "actions": [
        {
          "type": "skip_directum",
          "reason": "Письмо адресовано mailusers@taif.ru и не должно обрабатываться"
        }
      ]
    },
    {
      "name": "Skip scan",
      "enabled": true,
      "when": {
        "sender_email": "scan@taif.ru"
      },
      "actions": [
        {
          "type": "skip_directum",
          "reason": "Письмо  пришло со сканера и не должно обрабатываться"
        }
      ]
    },
    {
      "name": "Skip gosuslugi",
      "enabled": true,
      "when": {
        "sender_email": "no-reply@gosuslugi.ru"
      },
      "actions": [
        {
          "type": "skip_directum",
          "reason": "Письмо пришло с госуслуг"
        }
      ]
    },
    {
      "name": "Skip self response",
      "enabled": true,
      "when": {
        "sender_email": "bars@taif.ru"
      },
      "actions": [
        {
          "type": "skip_directum",
          "reason": "Письмо пришло с Барса"
        }
      ]
    },
    {
      "name": "Replace Directum person id 807 with 582",
      "enabled": true,
      "when": {
        "any_id": 807
      },
      "actions": [
        {
          "type": "replace_matched_id",
          "id": 582
        }
      ]
    },
    {
      "name": "Forward recipient 1564 to reception",
      "enabled": true,
      "when": {
        "recipient_id": 1564
      },
      "actions": [
        {
          "type": "forward_email",
          "to": "StryginaVM@taif.ru"
        },
        {
          "type": "skip_directum",
          "reason": "Письмо переслано в приёмную получателя: Стрыгина Валерия"
        }
      ]
    },
